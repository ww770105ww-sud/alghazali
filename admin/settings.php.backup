                            <input type="time" name="backup_schedule_time" class="form-control" style="max-width: 200px;"
                                   value="<?php echo htmlspecialchars($settings['backup_schedule_time'] ?? '03:00'); ?>">
                            <div class="form-text">يُستخدم مع «تنبيه عند حلول وقت النسخ» ومع أمر المهمة المجدولة (curl) في صفحة النسخ الاحتياطي.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">رمز استدعاء النسخ التلقائي (سري)</label>
                            <input type="text" name="backup_cron_secret" class="form-control font-monospace" dir="ltr" autocomplete="off"
                                   value="<?php echo htmlspecialchars($settings['backup_cron_secret'] ?? ''); ?>"
                                   placeholder="اتركه فارغاً للإبقاء على الرمز الحالي، أو أدخل رمزاً جديداً (16 حرفاً على الأقل)">
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" name="generate_backup_cron_secret" value="1" id="generate_backup_cron_secret">
                                <label class="form-check-label" for="generate_backup_cron_secret">توليد رمز جديد تلقائياً عند الحفظ</label>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-secondary border-0 rounded-3 small mb-0">
