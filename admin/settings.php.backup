    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-danger text-white py-3 rounded-top-4">
                <h5 class="modal-title fw-bold">تأكيد الحذف</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST">
                <input type="hidden" name="type_id" id="delete_type_id">
                <div class="modal-body p-4 text-center">
                    <div class="text-danger mb-3">
                        <i class="fas fa-exclamation-triangle fa-3x"></i>
                    </div>
                    <h5>هل أنت متأكد من حذف نوع المعاملة:</h5>
                    <h4 class="fw-bold mt-2" id="delete_type_name"></h4>
                    <p class="text-muted mt-3">لا يمكن التراجع عن هذا الإجراء إذا كان النوع غير مرتبط بمعاملات.</p>
                </div>
                <div class="modal-footer border-0 p-4 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" name="delete_passport_type" class="btn btn-danger rounded-pill px-4">حذف نهائياً</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    function addType() {
        $('#edit_id').val('');
        $('#type_name').val('');
        $('#default_cost').val('0');
        $('#default_sale_price').val('0');
        $('#type_currency_id').val($('#type_currency_id option:first').val());
        $('#is_active').prop('checked', true);
        $('.modal-title').text('إضافة نوع معاملة');
        $('#addTypeModal').modal('show');
    }

    function editType(data) {
        $('#edit_id').val(data.id);
        $('#type_name').val(data.type_name);
        $('#default_cost').val(data.default_cost);
        $('#default_sale_price').val(data.default_sale_price);
        $('#type_currency_id').val(data.currency_id);
        $('#is_active').prop('checked', data.is_active == 1);
        $('#print_terms').val(data.print_terms || '');
        $('.modal-title').text('تعديل نوع معاملة');
        $('#addTypeModal').modal('show');
    }

    function deleteType(id, name) {
        $('#delete_type_id').val(id);
        $('#delete_type_name').text(name);
        $('#deleteTypeModal').modal('show');
    }

    // تحديث التبويب النشط في الحقل المخفي وتحديث URL hash
    $('#settingsTabs .nav-link').on('shown.bs.tab', function(e) {
        var target = $(e.target).attr('data-bs-target').substring(1); // إزالة #
        $('#activeTabInput').val(target);

        // تحديث URL hash بدون إعادة تحميل الصفحة
        if (history.pushState) {
            history.pushState(null, null, '#' + target);
        } else {
            window.location.hash = '#' + target;
        }

        // إعادة تهيئة Select2 عند عرض التبويب (لأنه لا يعمل على العناصر المخفية)
        if (target === 'accounting' && typeof $ !== 'undefined' && $.fn.select2) {
            $('#accounting .select2').each(function() {
                $(this).select2({
                    dir: 'rtl',
                    width: '100%'
                });
            });
        }
    });

    // تفعيل التبويب من URL hash عند تحميل الصفحة
    $(document).ready(function() {
        var hash = window.location.hash.substring(1);
        if (hash) {
            var tab = $('#settingsTabs .nav-link[data-bs-target="#' + hash + '"]');
            if (tab.length) {
                // First, remove 'active' from all nav-links and 'show active' from all tab-panes
                $('#settingsTabs .nav-link').removeClass('active');
                $('.tab-pane').removeClass('show active');
                
                // Now activate the correct one
                tab.addClass('active');
                $('#' + hash).addClass('show active');
                
                // Also use Bootstrap Tab API to make sure everything works
                var bootstrapTab = new bootstrap.Tab(tab[0]);
                bootstrapTab.show();
                
                // إذا كان التبويب هو المحاسبة، نعيد تهيئة Select2 بعد فترة قصيرة
                if (hash === 'accounting' && $.fn.select2) {
                    setTimeout(function() {
                        $('#accounting .select2').each(function() {
                            $(this).select2({
                                dir: 'rtl',
                                width: '100%'
                            });
                        });
                    }, 100);
                }
            }
        }
    });

    // وظائف اختبار الأصوات
    function testNotificationSound() {
        const audio = new Audio('https://www.soundjay.com/misc/sounds/bell-ringing-05.wav');
        audio.volume = 0.3;
        audio.play().catch(() => {
            alert('لا يمكن تشغيل الصوت. تأكد من أن المتصفح يدعم تشغيل الأصوات.');
        });
    }

    function testMessageSound() {
        const audio = new Audio('https://www.soundjay.com/misc/sounds/message-sound.wav');
        audio.volume = 0.3;
        audio.play().catch(() => {
            alert('لا يمكن تشغيل الصوت. تأكد من أن المتصفح يدعم تشغيل الأصوات.');
        });
    }

    // منطق تبديل إعدادات الخدمات (بادئة الفواتير والقيود)
    $(document).ready(function() {
        $('#service_selector').on('change', function() {
            const srv = $(this).val();

            // جلب القيم من الحقول المخفية ووضعها في حقول العرض
            if (srv === 'general') {
                $('#display_sales_prefix').val($('#real_general_sales_prefix').val());
                $('#display_purchase_prefix').val($('#real_general_purchase_prefix').val());
                $('#display_journal_prefix').val($('#real_general_journal_prefix').val());
                $('#display_invoice_digits').val($('#real_general_digits').val());
            } else {
                $('#display_sales_prefix').val($('#real_' + srv + '_sales_prefix').val());
                $('#display_purchase_prefix').val($('#real_' + srv + '_purchase_prefix').val());
                $('#display_journal_prefix').val($('#real_' + srv + '_journal_prefix').val());
                $('#display_invoice_digits').val($('#real_' + srv + '_digits').val());
            }
        });

        // تحديث الحقول المخفية عند تغيير حقول العرض
        $('#display_sales_prefix, #display_purchase_prefix, #display_journal_prefix, #display_invoice_digits').on('input change', function() {
            const srv = $('#service_selector').val();
            const val = $(this).val();
            const id = $(this).attr('id');

            let targetId = '';
            if (id === 'display_sales_prefix') targetId = (srv === 'general' ? 'real_general_sales_prefix' : 'real_' + srv + '_sales_prefix');
            else if (id === 'display_purchase_prefix') targetId = (srv === 'general' ? 'real_general_purchase_prefix' : 'real_' + srv + '_purchase_prefix');
            else if (id === 'display_journal_prefix') targetId = (srv === 'general' ? 'real_general_journal_prefix' : 'real_' + srv + '_journal_prefix');
            else if (id === 'display_invoice_digits') targetId = (srv === 'general' ? 'real_general_digits' : 'real_' + srv + '_digits');

            $('#' + targetId).val(val);
        });
    });
</script>

