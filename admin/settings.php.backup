<?php
error_reporting(E_ALL);
ini_set('display_errors', 1);
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}
require_once '../includes/db.php';
require_once '../includes/functions.php';

// Auth check
if (!isset($_SESSION['admin_id'])) {
    header('Location: login.php');
    exit();
}

// Add missing csrf_input() function
if (!function_exists('csrf_input')) {
    function csrf_input() {
        $token = $_SESSION['csrf_token'] ?? '';
        return '<input type="hidden" name="csrf_token" value="' . htmlspecialchars($token) . '">';
    }
}

// Add default variables for domain_ssl tab
if (!isset($host)) $host = $_SERVER['HTTP_HOST'] ?? 'localhost';
if (!isset($db)) $db = 'database_name'; // Replace with actual DB name if needed
if (!isset($user)) $user = 'username'; // Replace with actual DB user if needed
if (!isset($charset)) $charset = 'utf8mb4';
$coa_accounts = $pdo->query("SELECT id, account_name_ar as account_name, account_code FROM unified_accounts WHERE id NOT IN (SELECT DISTINCT parent_id FROM unified_accounts WHERE parent_id IS NOT NULL) ORDER BY account_code ASC")->fetchAll();

$user_role = $_SESSION['role'] ?? 'editor';
$is_admin = ($user_role === 'admin' || $user_role === 'developer');

// إضافة/تعديل صلة قرابة (الزيارة العائلية)
if (isset($_POST['save_relationship'])) {
    if (!verify_csrf_token($_POST['csrf_token'] ?? '')) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'خطأ في التحقق من الطلب (CSRF).'];
        header('Location: settings.php?tab=family_visit#family_visit');
        exit();
    }
    $name_ar = $_POST['name_ar'];
    $name_en = $_POST['name_en'];
    $id = $_POST['id'] ?? null;

    if ($id) {
        $stmt = $pdo->prepare("UPDATE family_relationships SET name_ar = ?, name_en = ? WHERE id = ?");
        $stmt->execute([$name_ar, $name_en, $id]);
    } else {
        $stmt = $pdo->prepare("INSERT INTO family_relationships (name_ar, name_en) VALUES (?, ?)");
        $stmt->execute([$name_ar, $name_en]);
    }
    $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم حفظ صلة القرابة بنجاح.'];
    header('Location: settings.php?tab=family_visit#family_visit');
    exit();
}

// إضافة/تعديل متطلب (الزيارة العائلية)
if (isset($_POST['save_requirement'])) {
    if (!verify_csrf_token($_POST['csrf_token'] ?? '')) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'خطأ في التحقق من الطلب (CSRF).'];
        header('Location: settings.php?tab=family_visit#family_visit');
        exit();
    }
    $relationship_id = $_POST['relationship_id'];
    $requirement_name = $_POST['requirement_name'];
    $min_age = $_POST['min_age'] ?: 0;
    $max_age = $_POST['max_age'] ?: 200;
    $gender = $_POST['gender'] ?: 'both';
    $is_mandatory = isset($_POST['is_mandatory']) ? 1 : 0;
    $id = $_POST['id'] ?? null;

    if ($id) {
        $stmt = $pdo->prepare("UPDATE family_requirements SET relationship_id = ?, requirement_name = ?, min_age = ?, max_age = ?, gender = ?, is_mandatory = ? WHERE id = ?");
        $stmt->execute([$relationship_id, $requirement_name, $min_age, $max_age, $gender, $is_mandatory, $id]);
    } else {
        $stmt = $pdo->prepare("INSERT INTO family_requirements (relationship_id, requirement_name, min_age, max_age, gender, is_mandatory) VALUES (?, ?, ?, ?, ?, ?)");
        $stmt->execute([$relationship_id, $requirement_name, $min_age, $max_age, $gender, $is_mandatory]);
    }
    $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم حفظ المتطلب بنجاح.'];
    header('Location: settings.php?tab=family_visit#family_visit');
    exit();
}

// حذف (الزيارة العائلية) - تحويل إلى POST مع CSRF
if (isset($_POST['delete_rel'])) {
    if (!verify_csrf_token($_POST['csrf_token'] ?? '')) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'خطأ في التحقق من الطلب (CSRF).'];
        header('Location: settings.php?tab=family_visit#family_visit');
        exit();
    }
    $rel_id = intval($_POST['delete_rel']);
    // التحقق من عدم وجود سجلات مرتبطة قبل الحذف (Integrity check)
    $check_stmt = $pdo->prepare("SELECT COUNT(*) FROM family_requirements WHERE relationship_id = ?");
    $check_stmt->execute([$rel_id]);
    $count = $check_stmt->fetchColumn();
    if ($count > 0) {
        $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'لا يمكن حذف هذه الصلة لأنها تحتوي على متطلبات مرتبطة!'];
        header('Location: settings.php?tab=family_visit#family_visit');
        exit();
    }
    $pdo->prepare("DELETE FROM family_relationships WHERE id = ?")->execute([$rel_id]);
    $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم حذف الصلة بنجاح.'];
    header('Location: settings.php?tab=family_visit#family_visit');
    exit();
}
if (isset($_POST['delete_req'])) {
    if (!verify_csrf_token($_POST['csrf_token'] ?? '')) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'خطأ في التحقق من الطلب (CSRF).'];
        header('Location: settings.php?tab=family_visit#family_visit');
        exit();
    }
    $pdo->prepare("DELETE FROM family_requirements WHERE id = ?")->execute([intval($_POST['delete_req'])]);
    $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم حذف المتطلب بنجاح.'];
    header('Location: settings.php?tab=family_visit#family_visit');
    exit();
}


// تحديث الإعدادات العامة وروابط التواصل
if (isset($_POST['update_settings'])) {
    $active_tab = $_POST['active_tab'] ?? 'general';

    if ($active_tab === 'backup' && !$is_admin) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'غير مصرح لك بتعديل إعدادات النسخ الاحتياطي.'];
        header('Location: settings.php?tab=general#general');
        exit();
    }

    $pdo->beginTransaction();
    try {
        // قائمة الإعدادات المتوقعة وأنواعها للتحقق
        $expected_settings = [
            'site_name' => 'string',
            'email' => 'email',
            'phone' => 'string',
            'address' => 'string',
            'latitude' => 'string',
            'longitude' => 'string',
            'primary_color' => 'color',
            'secondary_color' => 'color',
            'header_color' => 'color',
            'footer_color' => 'color',
            'batch_repeat_days' => 'int',
            'max_passports_per_batch' => 'int',
            'ticker_speed' => 'int',
            'ticker_bg_color' => 'color',
            'sidebar_color' => 'color',
            'menu_btn_color' => 'color',
            'slider_interval' => 'int',
            'query_bg_color' => 'color',
            'query_btn_color' => 'color',
            'query_title' => 'string',
            'meta_description' => 'string',
            'meta_keywords' => 'string',
            'google_verification' => 'string',
            'copyright_text' => 'string',
            'default_profit_account_id' => 'int',
            'developer_name' => 'string',
            'developer_link' => 'url',
            'edit_delete_time_limit' => 'int',
            'disappear_after_read_seconds' => 'int',
            // Checkboxes (boolean)
            'slider_autoplay' => 'bool',
            'slider_controls' => 'bool',
            'show_ticker' => 'bool',
            'show_office_name' => 'bool',
            'show_passport_query' => 'bool',
            'enable_work_visa' => 'bool',
            'enable_family_visit' => 'bool',
            'enable_bus_flight_bookings' => 'bool',
            'enable_passport_transactions' => 'bool',
            'enable_umrah' => 'bool',
            'enable_bus_bookings' => 'bool',
            'enable_flight_bookings' => 'bool',
            'bookings_show_profit' => 'bool',
            'bookings_show_purchase_price' => 'bool',
            'bookings_allow_partial_payments' => 'bool',
            'bookings_enable_print' => 'bool',
            'bookings_enable_export' => 'bool',
            'bookings_enable_return_date' => 'bool',
            'bookings_enable_bus_type' => 'bool',
            'bookings_auto_posting' => 'bool',
            'passports_auto_posting' => 'bool',
            'bookings_workflow_enabled' => 'bool',
            'bookings_auto_numbering' => 'bool',
            'auto_invoice_generation' => 'bool',
            'passport_allow_discount' => 'bool',
            'auto_delete_messages' => 'bool',
            'enable_notification_sound' => 'bool',
            'enable_message_sound' => 'bool',
            'show_service_terms' => 'bool',
            'show_general_terms' => 'bool',
            // Colors
            'primary_color_light' => 'color',
            'secondary_color_light' => 'color',
            'success_color_light' => 'color',
            'danger_color_light' => 'color',
            'warning_color_light' => 'color',
            'info_color_light' => 'color',
            'text_color_light' => 'color',
            'bg_color_light' => 'color',
            'card_bg_light' => 'color',
            'border_color_light' => 'color',
            'primary_color_dark' => 'color',
            'secondary_color_dark' => 'color',
            'success_color_dark' => 'color',
            'danger_color_dark' => 'color',
            'warning_color_dark' => 'color',
            'info_color_dark' => 'color',
            'text_color_dark' => 'color',
            'bg_color_dark' => 'color',
            'card_bg_dark' => 'color',
            'border_color_dark' => 'color',
            'sidebar_bg_light' => 'color',
            'sidebar_text_light' => 'color',
            'sidebar_icon_color_light' => 'color',
            'sidebar_bg_dark' => 'color',
            'sidebar_text_dark' => 'color',
            'sidebar_icon_color_dark' => 'color',
            // Buttons
            'show_login_button' => 'bool',
            'show_visit_site_button' => 'bool',
            'show_theme_toggle_button' => 'bool',
            'show_quick_access_button' => 'bool',
            'show_search_button' => 'bool',
            'show_fullscreen_button' => 'bool',
            'show_notifications_button' => 'bool',
            'base_currency_id' => 'int',
            'invoice_posting_trigger' => 'string',
            'sales_invoice_prefix' => 'string',
            'purchase_invoice_prefix' => 'string',
            'invoice_number_digits' => 'int',
            'srv_bus_sales_prefix' => 'string',
            'srv_bus_purchase_prefix' => 'string',
            'srv_bus_digits' => 'int',
            'srv_flight_sales_prefix' => 'string',
            'srv_flight_purchase_prefix' => 'string',
            'srv_flight_digits' => 'int',
            'srv_visa_sales_prefix' => 'string',
            'srv_visa_purchase_prefix' => 'string',
            'srv_visa_digits' => 'int',
            'srv_umrah_sales_prefix' => 'string',
            'srv_umrah_purchase_prefix' => 'string',
            'srv_umrah_digits' => 'int',
            'srv_family_sales_prefix' => 'string',
            'srv_family_purchase_prefix' => 'string',
            'srv_family_digits' => 'int',
            'srv_passport_sales_prefix' => 'string',
            'srv_passport_purchase_prefix' => 'string',
            'srv_passport_digits' => 'int',
            'revenue_bus_account_id' => 'int',
            'cost_bus_account_id' => 'int',
            'profit_bus_account_id' => 'int',
            'revenue_flight_account_id' => 'int',
            'cost_flight_account_id' => 'int',
            'profit_flight_account_id' => 'int',
            'revenue_work_visa_account_id' => 'int',
            'cost_work_visa_account_id' => 'int',
            'profit_work_visa_account_id' => 'int',
            'revenue_umrah_account_id' => 'int',
            'cost_umrah_account_id' => 'int',
            'profit_umrah_account_id' => 'int',
            'revenue_family_visit_account_id' => 'int',
            'cost_family_visit_account_id' => 'int',
            'profit_family_visit_account_id' => 'int',
            'passports_revenue_account' => 'int',
            'passports_cost_account' => 'int',
            'passports_profit_account' => 'int',
            'umrah_service_terms' => 'text',
            'work_visa_service_terms' => 'text',
            'family_visit_service_terms' => 'text',
            'bus_flight_service_terms' => 'text',
            'passport_service_terms' => 'text',
            'exchange_gain_account_id' => 'int',
            'exchange_loss_account_id' => 'int',
            'customer_receivable_account_id' => 'int',
            'supplier_payable_account_id' => 'int',
            'default_cash_account_id' => 'int',
            'default_bank_account_id' => 'int',
            'default_cost_account_id' => 'int',
            'fiscal_start_date' => 'string',
            'fiscal_end_date' => 'string',
            'enable_recycle_bin' => 'bool',
            'default_delivery_type' => 'string',
            'default_sales_account_id' => 'int',
            'default_purchase_account_id' => 'int',
            'journal_prefix' => 'string',
                            'journal_digits' => 'int',
                            'srv_bus_journal_prefix' => 'string',
                            'srv_flight_journal_prefix' => 'string',
                            'srv_passport_journal_prefix' => 'string',
                            'srv_umrah_journal_prefix' => 'string',
                            'srv_family_journal_prefix' => 'string',
                            'srv_visa_journal_prefix' => 'string',
                            'enable_automatic_reconciliation' => 'bool',
                            'require_cost_center' => 'bool',
                            'allow_negative_balance' => 'bool',
                            'enable_customer_limit_check' => 'bool',
                            'enable_supplier_limit_check' => 'bool',
                            'enable_debit_limit_check' => 'bool',
                            'enable_tax_fields' => 'bool',
                            // النسخ الاحتياطي لقاعدة البيانات
                            'backup_local_enabled' => 'bool',
                            'backup_local_path' => 'path_safe',
                            'backup_schedule_time' => 'time_hm',
                            'backup_notify_due' => 'bool',
        ];

        foreach ($expected_settings as $key => $type) {
            if (strncmp((string)$key, 'backup_', 7) === 0 && ($active_tab ?? '') !== 'backup') {
                continue;
            }
            if (isset($_POST[$key]) || $type === 'bool') {
                $value = $_POST[$key] ?? 0;
            } else {
                continue;
            }

            // Sanitize and validate based on type
            switch ($type) {
                case 'int':
                    $value = filter_var($value, FILTER_VALIDATE_INT, ['options' => ['default' => 0]]);
                    break;
                case 'email':
                    $value = filter_var($value, FILTER_SANITIZE_EMAIL);
                    if ($value && !filter_var($value, FILTER_VALIDATE_EMAIL)) $value = '';
                    break;
                case 'url':
                    $value = filter_var($value, FILTER_SANITIZE_URL);
                    if ($value && !filter_var($value, FILTER_VALIDATE_URL)) $value = '';
                    break;
                case 'color':
                    $value = preg_match('/^#[a-f0-9]{6}$/i', $value) ? $value : '#000000';
                    break;
                case 'bool':
                    $value = isset($_POST[$key]) ? 1 : 0;
                    break;
                case 'path_safe':
                    $value = trim((string)$value);
                    $value = str_replace(["\0", '..'], '', $value);
                    $value = preg_replace('#^[\\/]+#', '', $value);
                    $value = preg_replace('#[\\/]{2,}#', '/', $value);
                    if (strlen($value) > 240) {
                        $value = substr($value, 0, 240);
                    }
                    if ($value === '') {
                        $value = 'storage/db_backups';
                    }
                    break;
                case 'time_hm':
                    $value = trim((string)$value);
                    if (preg_match('/^(\d{1,2}):(\d{2})/', $value, $m)) {
                        $h = min(23, max(0, (int)$m[1]));
                        $min = min(59, max(0, (int)$m[2]));
                        $value = sprintf('%02d:%02d', $h, $min);
                    } else {
                        $value = '03:00';
                    }
                    break;
                case 'text':
                    $value = trim((string)$value);
                    break;
                case 'string':
                default:
                    $value = htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
                    break;
            }

            $stmt = $pdo->prepare("INSERT INTO system_settings (setting_key, setting_value, setting_group)
                                   VALUES (?, ?, ?)
                                   ON DUPLICATE KEY UPDATE setting_value = VALUES(setting_value)");
            $stmt->execute([$key, $value, 'general']);
        }

        // رمز استدعاء النسخ الاحتياطي المجدول (تبويب backup)
        if (($active_tab ?? '') === 'backup') {
            $secStmt = $pdo->prepare(
                "INSERT INTO system_settings (setting_key, setting_value, setting_group)
                 VALUES ('backup_cron_secret', ?, 'general')
                 ON DUPLICATE KEY UPDATE setting_value = VALUES(setting_value)"
            );
            if (!empty($_POST['generate_backup_cron_secret'])) {
                $secStmt->execute([bin2hex(random_bytes(16))]);
            } else {
                $rawSecret = trim((string)($_POST['backup_cron_secret'] ?? ''));
                if ($rawSecret !== '') {
                    $clean = preg_replace('/[^a-zA-Z0-9]/', '', $rawSecret);
                    if (strlen($clean) >= 16) {
                        $secStmt->execute([$clean]);
                    }
                }
            }
            $curSec = $pdo->query("SELECT setting_value FROM system_settings WHERE setting_key = 'backup_cron_secret' LIMIT 1")->fetchColumn();
            if (trim((string)$curSec) === '' && !empty($_POST['backup_local_enabled'])) {
                $secStmt->execute([bin2hex(random_bytes(16))]);
            }
        }

        // تحديث روابط العملاء والموردين بدليل الحسابات
        foreach ($_POST as $post_key => $post_val) {
            if (strpos($post_key, 'cust_coa_') === 0) {
                $cust_id = str_replace('cust_coa_', '', $post_key);
                $account_id = !empty($post_val) ? intval($post_val) : null;
                $pdo->prepare("UPDATE customers SET account_id = ? WHERE id = ?")->execute([$account_id, $cust_id]);
            } elseif (strpos($post_key, 'supp_coa_') === 0) {
                $supp_id = str_replace('supp_coa_', '', $post_key);
                $account_id = !empty($post_val) ? intval($post_val) : null;
                $pdo->prepare("UPDATE suppliers SET account_id = ? WHERE id = ?")->execute([$account_id, $supp_id]);
            }
        }

        // تحديث الشعارات بشكل منفصل - مع أمان
        $upload_dir = '../assets/uploads/';
        if (!is_dir($upload_dir)) mkdir($upload_dir, 0755, true);
        $max_size = 2 * 1024 * 1024; // 2MB
        $allowed_image_types = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
        $allowed_favicon_types = ['image/x-icon', 'image/vnd.microsoft.icon', 'image/png'];

        // معالجة site_logo
        if (!empty($_FILES['site_logo']['name'])) {
            if ($_FILES['site_logo']['error'] !== UPLOAD_ERR_OK) {
                $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'حدث خطأ أثناء رفع الشعار!'];
            } elseif ($_FILES['site_logo']['size'] > $max_size) {
                $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'الملف كبير جدًا! الحد الأقصى هو 2MB.'];
            } else {
                $finfo = finfo_open(FILEINFO_MIME_TYPE);
                $mime_type = finfo_file($finfo, $_FILES['site_logo']['tmp_name']);
                finfo_close($finfo);
                if (in_array($mime_type, $allowed_image_types)) {
                    $ext = pathinfo($_FILES['site_logo']['name'], PATHINFO_EXTENSION);
                    $filename = 'site_logo_' . time() . '_' . bin2hex(random_bytes(8)) . '.' . $ext;
                    if (move_uploaded_file($_FILES['site_logo']['tmp_name'], $upload_dir . $filename)) {
                        $stmt = $pdo->prepare("INSERT INTO system_settings (setting_key, setting_value, setting_group) VALUES ('site_logo', ?, 'general') ON DUPLICATE KEY UPDATE setting_value = VALUES(setting_value)");
                        $stmt->execute([$filename]);
                        $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم رفع شعار الموقع بنجاح!'];
                    }
                } else {
                    $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'نوع الملف غير مسموح به!'];
                }
            }
        }
        // معالجة site_favicon
        if (!empty($_FILES['site_favicon']['name'])) {
            if ($_FILES['site_favicon']['error'] !== UPLOAD_ERR_OK) {
                $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'حدث خطأ أثناء رفع الفافيكون!'];
            } elseif ($_FILES['site_favicon']['size'] > $max_size) {
                $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'الملف كبير جدًا! الحد الأقصى هو 2MB.'];
            } else {
                $finfo = finfo_open(FILEINFO_MIME_TYPE);
                $mime_type = finfo_file($finfo, $_FILES['site_favicon']['tmp_name']);
                finfo_close($finfo);
                $allowed = array_merge($allowed_image_types, $allowed_favicon_types);
                if (in_array($mime_type, $allowed)) {
                    $ext = pathinfo($_FILES['site_favicon']['name'], PATHINFO_EXTENSION);
                    $filename = 'favicon_' . time() . '_' . bin2hex(random_bytes(8)) . '.' . $ext;
                    if (move_uploaded_file($_FILES['site_favicon']['tmp_name'], $upload_dir . $filename)) {
                        $stmt = $pdo->prepare("INSERT INTO system_settings (setting_key, setting_value, setting_group) VALUES ('site_favicon', ?, 'general') ON DUPLICATE KEY UPDATE setting_value = VALUES(setting_value)");
                        $stmt->execute([$filename]);
                        $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم رفع الفافيكون بنجاح!'];
                    }
                } else {
                    $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'نوع الملف غير مسموح به!'];
                }
            }
        }
        // معالجة print_logo
        if (!empty($_FILES['print_logo']['name'])) {
            if ($_FILES['print_logo']['error'] !== UPLOAD_ERR_OK) {
                $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'حدث خطأ أثناء رفع شعار الطباعة!'];
            } elseif ($_FILES['print_logo']['size'] > $max_size) {
                $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'الملف كبير جدًا! الحد الأقصى هو 2MB.'];
            } else {
                $finfo = finfo_open(FILEINFO_MIME_TYPE);
                $mime_type = finfo_file($finfo, $_FILES['print_logo']['tmp_name']);
                finfo_close($finfo);
                if (in_array($mime_type, $allowed_image_types)) {
                    $ext = pathinfo($_FILES['print_logo']['name'], PATHINFO_EXTENSION);
                    $filename = 'print_' . time() . '_' . bin2hex(random_bytes(8)) . '.' . $ext;
                    if (move_uploaded_file($_FILES['print_logo']['tmp_name'], $upload_dir . $filename)) {
                        $stmt = $pdo->prepare("INSERT INTO system_settings (setting_key, setting_value, setting_group) VALUES ('print_logo', ?, 'general') ON DUPLICATE KEY UPDATE setting_value = VALUES(setting_value)");
                        $stmt->execute([$filename]);
                        $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم رفع شعار الطباعة بنجاح!'];
                    }
                } else {
                    $_SESSION['flash_message'] = ['type' => 'warning', 'title' => 'تحذير!', 'body' => 'نوع الملف غير مسموح به!'];
                }
            }
        }

        // تحسين إدارة روابط التواصل الاجتماعي
        $posted_ids = [];
        if (isset($_POST['social_link_id'])) {
            foreach ($_POST['social_link_id'] as $key => $id) {
                $platform_name = trim($_POST['social_platform_name'][$key] ?? '');
                $link_url = trim($_POST['social_link_url'][$key] ?? '');

                if (empty($platform_name) || empty($link_url)) continue;

                $platform_icon = match ($platform_name) {
                    'Facebook' => 'fab fa-facebook-f',
                    'Twitter' => 'fab fa-twitter',
                    'Instagram' => 'fab fa-instagram',
                    'LinkedIn' => 'fab fa-linkedin-in',
                    'YouTube' => 'fab fa-youtube',
                    'WhatsApp' => 'fab fa-whatsapp',
                    'Telegram' => 'fab fa-telegram-plane',
                    'TikTok' => 'fab fa-tiktok',
                    default => 'fas fa-link',
                };

                if ($id == 0) {
                    $stmt = $pdo->prepare("INSERT INTO social_links (platform_name, platform_icon, link_url) VALUES (?, ?, ?)");
                    $stmt->execute([$platform_name, $platform_icon, $link_url]);
                    $posted_ids[] = $pdo->lastInsertId();
                } else {
                    $stmt = $pdo->prepare("UPDATE social_links SET platform_name = ?, platform_icon = ?, link_url = ? WHERE id = ?");
                    $stmt->execute([$platform_name, $platform_icon, $link_url, $id]);
                    $posted_ids[] = $id;
                }
            }
        }

        $current_ids = $pdo->query("SELECT id FROM social_links")->fetchAll(PDO::FETCH_COLUMN);
        $ids_to_delete = array_diff($current_ids, $posted_ids);
        if (!empty($ids_to_delete)) {
            $placeholders = implode(',', array_fill(0, count($ids_to_delete), '?'));
            $stmt = $pdo->prepare("DELETE FROM social_links WHERE id IN ($placeholders)");
            $stmt->execute(array_values($ids_to_delete));
        }

        $pdo->commit();
        $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم تحديث الإعدادات بنجاح.'];
        header("Location: settings.php?tab=$active_tab#$active_tab");
        exit();
    } catch (Exception $e) {
        if ($pdo->inTransaction()) $pdo->rollBack();
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'حدث خطأ: ' . $e->getMessage()];
        header("Location: settings.php?tab=$active_tab#$active_tab");
        exit();
    }
}

// Handle Add/Edit Passport Transaction Type
if (isset($_POST['save_type'])) {
    if (!has_permission('passport_transactions_settings')) { // Add permission check
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'ليس لديك الصلاحية لتعديل تسعيرات المعاملات.'];
        header('Location: settings.php?tab=passport-pricing#passport-pricing');
        exit();
    }

    $id = $_POST['id'] ?? null;
    $type_name = $_POST['type_name'];
    $default_cost = $_POST['default_cost'];
    $default_sale_price = $_POST['default_sale_price'];
    $currency_id = $_POST['currency_id'];
    $is_active = isset($_POST['is_active']) ? 1 : 0;
    $print_terms = $_POST['print_terms'] ?? '';

    try {
        if ($id) {
            $stmt = $pdo->prepare("UPDATE passport_transaction_types SET type_name = ?, default_cost = ?, default_sale_price = ?, currency_id = ?, is_active = ?, print_terms = ? WHERE id = ?");
            $stmt->execute([$type_name, $default_cost, $default_sale_price, $currency_id, $is_active, $print_terms, $id]);
            $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم تحديث النوع بنجاح.'];
        } else {
            $stmt = $pdo->prepare("INSERT INTO passport_transaction_types (type_name, default_cost, default_sale_price, currency_id, is_active, print_terms) VALUES (?, ?, ?, ?, ?, ?)");
            $stmt->execute([$type_name, $default_cost, $default_sale_price, $currency_id, $is_active, $print_terms]);
            $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تمت إضافة النوع بنجاح.'];
        }
        header('Location: settings.php?tab=passport-pricing#passport-pricing');
        exit();
    } catch (PDOException $e) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'خطأ: ' . $e->getMessage()];
        header('Location: settings.php?tab=passport-pricing#passport-pricing');
        exit();
    }
}

// Handle Add/Edit Attendance Location
if (isset($_POST['save_attendance_location'])) {
    if (!verify_csrf_token($_POST['csrf_token'] ?? '')) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'خطأ في التحقق من الطلب (CSRF).'];
        header('Location: settings.php#attendance');
        exit();
    }

    $id = $_POST['id'] ?? null;
    $name = $_POST['location_name'];
    $latitude = $_POST['location_latitude'];
    $longitude = $_POST['location_longitude'];
    $radius = $_POST['location_radius'] ?: 100;
    $is_active = isset($_POST['location_is_active']) ? 1 : 0;

    try {
        $pdo->beginTransaction();
        
        if ($id) {
            $stmt = $pdo->prepare("UPDATE attendance_locations SET name = ?, latitude = ?, longitude = ?, radius_meters = ?, is_active = ? WHERE id = ?");
            $stmt->execute([$name, $latitude, $longitude, $radius, $is_active, $id]);
            $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم تحديث الموقع بنجاح.'];
        } else {
            $stmt = $pdo->prepare("INSERT INTO attendance_locations (name, latitude, longitude, radius_meters, is_active) VALUES (?, ?, ?, ?, ?)");
            $stmt->execute([$name, $latitude, $longitude, $radius, $is_active]);
            $id = $pdo->lastInsertId();
            $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تمت إضافة الموقع بنجاح.'];
        }
        
        // Update employee assignments
        // First, unassign all employees from this location
        $stmt = $pdo->prepare("UPDATE employees SET attendance_location_id = NULL WHERE attendance_location_id = ?");
        $stmt->execute([$id]);
        
        // Then assign selected employees
        $assigned_employees = $_POST['assigned_employees'] ?? [];
        if (!empty($assigned_employees)) {
            $placeholders = str_repeat('?,', count($assigned_employees) - 1) . '?';
            $stmt = $pdo->prepare("UPDATE employees SET attendance_location_id = ? WHERE id IN ($placeholders)");
            $stmt->execute(array_merge([$id], $assigned_employees));
        }
        
        $pdo->commit();
        header('Location: settings.php?tab=attendance#attendance');
        exit();
    } catch (PDOException $e) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'خطأ: ' . $e->getMessage()];
        header('Location: settings.php?tab=attendance#attendance');
        exit();
    }
}

// Handle Delete Attendance Location
if (isset($_POST['delete_attendance_location'])) {
    $id = $_POST['location_id'];
    try {
        $stmt = $pdo->prepare("DELETE FROM attendance_locations WHERE id = ?");
        $stmt->execute([$id]);
        $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم حذف الموقع بنجاح.'];
    } catch (PDOException $e) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'لا يمكن حذف هذا الموقع.'];
    }
    header('Location: settings.php?tab=attendance#attendance');
    exit();
}

// Handle Delete Passport Transaction Type
if (isset($_POST['delete_passport_type'])) {
    $id = $_POST['type_id'];
    try {
        $stmt = $pdo->prepare("DELETE FROM passport_transaction_types WHERE id = ?");
        $stmt->execute([$id]);
        $_SESSION['flash_message'] = ['type' => 'success', 'title' => 'نجاح!', 'body' => 'تم حذف نوع المعاملة بنجاح.'];
    } catch (PDOException $e) {
        $_SESSION['flash_message'] = ['type' => 'danger', 'title' => 'خطأ!', 'body' => 'لا يمكن حذف هذا النوع لأنه مرتبط بمعاملات موجودة.'];
    }
    header('Location: settings.php?tab=passport-pricing#passport-pricing');
    exit();
}

// Fetch Attendance Locations
$attendance_locations = $pdo->query("SELECT * FROM attendance_locations ORDER BY id ASC")->fetchAll();

// Fetch Active Employees
$employees_list = $pdo->query("SELECT id, full_name FROM employees WHERE deleted_at IS NULL ORDER BY full_name ASC")->fetchAll();

// Pre-fetch assigned employees for each location
$location_employees_map = [];
foreach ($attendance_locations as $loc) {
    $stmt = $pdo->prepare("SELECT id FROM employees WHERE attendance_location_id = ? AND deleted_at IS NULL");
    $stmt->execute([$loc['id']]);
    $location_employees_map[$loc['id']] = $stmt->fetchAll(PDO::FETCH_COLUMN, 0);
}

// Fetch Types for display in the tab
$passport_transaction_types = $pdo->query("
    SELECT t.*, c.currency_name, c.currency_symbol
    FROM passport_transaction_types t
    LEFT JOIN currencies c ON t.currency_id = c.id
    ORDER BY t.type_name
")->fetchAll();
$currencies_list = $pdo->query("SELECT id, currency_name, currency_symbol FROM currencies WHERE is_active = 1 ORDER BY currency_name ASC")->fetchAll();

require_once 'header.php';

