                    <div class="section-title mt-4"><i class="fas fa-university text-primary"></i> الحسابات الافتراضية الرئيسية (النظام الموحد)</div>
                    <div class="row g-4 mb-4">
                        <?php
                        $coa_accounts = $pdo->query("SELECT id, account_name_ar as account_name, account_code FROM unified_accounts WHERE id NOT IN (SELECT DISTINCT parent_id FROM unified_accounts WHERE parent_id IS NOT NULL) ORDER BY account_code ASC")->fetchAll();

                        $main_accounts = [
                            'customer_receivable_account_id' => ['label' => 'حساب العملاء (مدينون)', 'prefix' => '11201', 'icon' => 'fa-users'],
                            'supplier_payable_account_id' => ['label' => 'حساب الموردين (دائنون)', 'prefix' => '21101', 'icon' => 'fa-truck'],
                            'default_cash_account_id' => ['label' => 'حساب الصندوق الافتراضي', 'prefix' => '11101', 'icon' => 'fa-money-bill-wave'],
                            'default_bank_account_id' => ['label' => 'حساب البنك الافتراضي', 'prefix' => '11102', 'icon' => 'fa-university'],
                            'exchange_gain_account_id' => ['label' => 'أرباح فروقات العملات', 'prefix' => '402', 'icon' => 'fa-chart-line'],
                            'exchange_loss_account_id' => ['label' => 'خسائر فروقات العملات', 'prefix' => '5', 'icon' => 'fa-chart-area'],
                            'default_sales_account_id' => ['label' => 'حساب المبيعات العام', 'prefix' => '4', 'icon' => 'fa-shopping-cart'],
                            'default_purchase_account_id' => ['label' => 'حساب المشتريات العام', 'prefix' => '5', 'icon' => 'fa-shopping-basket'],
                            'default_cost_account_id' => ['label' => 'حساب التكلفة الافتراضي', 'prefix' => '5', 'icon' => 'fa-file-invoice-dollar'],
                            'default_profit_account_id' => ['label' => 'حساب الأرباح (Profit)', 'prefix' => '3', 'icon' => 'fa-piggy-bank'],
                        ];

                        foreach ($main_accounts as $key => $data):
                            $label = $data['label'];
                            $prefix = $data['prefix'];
                            $icon = $data['icon'];
                        ?>
                            <div class="col-md-4">
                                <div class="p-3 border rounded-3 bg-white h-100 shadow-sm">
                                    <label class="form-label small fw-bold"><i class="fas <?php echo $icon; ?> me-1 text-primary"></i> <?php echo $label; ?></label>
                                    <select name="<?php echo $key; ?>" class="form-select form-select-sm select2">
                                        <option value="">--- اختر من الدليل ---</option>
                                        <?php foreach ($coa_accounts as $acc):
                                            if (strpos($acc['account_code'], $prefix) !== 0) continue;
                                        ?>
                                            <option value="<?php echo $acc['id']; ?>" <?php echo (($settings[$key] ?? '') == $acc['id']) ? 'selected' : ''; ?>>
                                                <?php echo $acc['account_code'] . ' - ' . htmlspecialchars($acc['account_name']); ?>
                                            </option>
                                        <?php endforeach; ?>
                                    </select>
                                </div>
                            </div>
                        <?php endforeach; ?>
                    </div>

                    <div class="section-title mt-4"><i class="fas fa-tags text-primary"></i> حسابات الإيرادات والتكاليف لكل خدمة</div>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle bg-white">
                            <thead class="bg-light">
                                <tr>
                                    <th style="width: 200px;">الخدمة</th>
                                    <th>حساب الإيرادات (Revenue)</th>
                                    <th>حساب التكلفة (Cost)</th>
                                    <th>حساب الأرباح (Profit)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php
                                $services = [
                                    ['id' => 'bus', 'label' => 'حجوزات الباصات', 'rev_prefix' => '4010101', 'cost_prefix' => '5010101', 'profit_prefix' => '4010201'],
                                    ['id' => 'flight', 'label' => 'حجوزات الطيران', 'rev_prefix' => '4010102', 'cost_prefix' => '5010102', 'profit_prefix' => '4010202'],
                                    ['id' => 'work_visa', 'label' => 'تأشيرات العمل', 'rev_prefix' => '4010103', 'cost_prefix' => '5010103', 'profit_prefix' => '4010203'],
                                    ['id' => 'umrah', 'label' => 'قسم العمرة', 'rev_prefix' => '4010104', 'cost_prefix' => '5010104', 'profit_prefix' => '4010204'],
                                    ['id' => 'family_visit', 'label' => 'الزيارة العائلية', 'rev_prefix' => '4010105', 'cost_prefix' => '5010105', 'profit_prefix' => '4010205'],
                                    ['id' => 'passport', 'label' => 'معاملات الجوازات العام', 'rev_prefix' => '4010106', 'cost_prefix' => '5010106', 'profit_prefix' => '4010206', 'custom_keys' => ['rev' => 'passports_revenue_account', 'cost' => 'passports_cost_account', 'profit' => 'passports_profit_account']],
                                ];
                                foreach ($services as $service):
                                    $rev_key = $service['custom_keys']['rev'] ?? ("revenue_" . $service['id'] . "_account_id");
                                    $cost_key = $service['custom_keys']['cost'] ?? ("cost_" . $service['id'] . "_account_id");
                                    $profit_key = $service['custom_keys']['profit'] ?? ("profit_" . $service['id'] . "_account_id");
                                    // Find default account IDs for this service (the first match for each prefix)
                                    $default_rev_id = null;
                                    $default_cost_id = null;
                                    $default_profit_id = null;
                                    foreach ($coa_accounts as $acc) {
                                        if (isset($service['rev_prefix']) && strpos($acc['account_code'], $service['rev_prefix']) === 0 && is_null($default_rev_id)) $default_rev_id = $acc['id'];
                                        if (isset($service['cost_prefix']) && strpos($acc['account_code'], $service['cost_prefix']) === 0 && is_null($default_cost_id)) $default_cost_id = $acc['id'];
                                        if (isset($service['profit_prefix']) && strpos($acc['account_code'], $service['profit_prefix']) === 0 && is_null($default_profit_id)) $default_profit_id = $acc['id'];
                                    }
                                    // Use the default if no setting is saved
                                    $current_rev_id = $settings[$rev_key] ?? $default_rev_id;
                                    $current_cost_id = $settings[$cost_key] ?? $default_cost_id;
                                    $current_profit_id = $settings[$profit_key] ?? $default_profit_id;
                                ?>
                                    <tr>
                                        <td class="fw-bold bg-light px-3"><?php echo $service['label']; ?></td>
                                        <td>
                                            <select name="<?php echo $rev_key; ?>" class="form-select form-select-sm border-0 select2">
                                                <option value="">--- اختر حساب الإيراد ---</option>
                                                <?php foreach ($coa_accounts as $acc): 
                                                    if (isset($service['rev_prefix']) && strpos($acc['account_code'], $service['rev_prefix']) !== 0) continue;
                                                ?>
                                                    <option value="<?php echo $acc['id']; ?>" <?php echo (($current_rev_id ?? '') == $acc['id']) ? 'selected' : ''; ?>>
                                                        <?php echo $acc['account_code'] . ' - ' . htmlspecialchars($acc['account_name']); ?>
                                                    </option>
                                                <?php endforeach; ?>
                                            </select>
                                        </td>
                                        <td>
                                            <select name="<?php echo $cost_key; ?>" class="form-select form-select-sm border-0 select2">
                                                <option value="">--- اختر حساب التكلفة ---</option>
                                                <?php foreach ($coa_accounts as $acc): 
                                                    if (isset($service['cost_prefix']) && strpos($acc['account_code'], $service['cost_prefix']) !== 0) continue;
                                                ?>
                                                    <option value="<?php echo $acc['id']; ?>" <?php echo (($current_cost_id ?? '') == $acc['id']) ? 'selected' : ''; ?>>
                                                        <?php echo $acc['account_code'] . ' - ' . htmlspecialchars($acc['account_name']); ?>
                                                    </option>
                                                <?php endforeach; ?>
                                            </select>
                                        </td>
                                        <td>
                                            <select name="<?php echo $profit_key; ?>" class="form-select form-select-sm border-0 select2">
                                                <option value="">--- اختر حساب الأرباح ---</option>
                                                <?php foreach ($coa_accounts as $acc): 
                                                    if (isset($service['profit_prefix']) && strpos($acc['account_code'], $service['profit_prefix']) !== 0) continue;
                                                ?>
                                                    <option value="<?php echo $acc['id']; ?>" <?php echo (($current_profit_id ?? '') == $acc['id']) ? 'selected' : ''; ?>>
                                                        <?php echo $acc['account_code'] . ' - ' . htmlspecialchars($acc['account_name']); ?>
                                                    </option>
                                                <?php endforeach; ?>
                                            </select>
                                        </td>
                                    </tr>
                                <?php endforeach; ?>
                            </tbody>
                        </table>
                    </div>
                </div>

