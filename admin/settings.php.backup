                    <!-- إعدادات إعادة التوجيه إلى HTTPS -->
                    <div class="row mb-5">
                        <div class="col-12">
                            <div class="section-title"><i class="fas fa-redirect text-info"></i> إعادة التوجيه إلى HTTPS</div>
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <p class="text-muted mb-3">إضافة هذا الكود إلى ملف <code>.htaccess</code> في جذر الموقع لإعادة توجيه جميع الطلبات إلى HTTPS تلقائياً:</p>
                                    <div class="bg-dark text-light p-3 rounded-3 font-monospace small overflow-auto">
                                        <pre class="mb-0"># إعادة التوجيه إلى HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# إعادة توجيه www إلى غير www (أو العكس)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]</pre>
                                    </div>
                                    <button class="btn btn-outline-primary btn-sm mt-3" onclick="navigator.clipboard.writeText(document.querySelector('#domain_ssl pre').textContent)">
                                        <i class="fas fa-copy me-1"></i> نسخ الكود
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- إعدادات الحماية والأمان -->
                    <div class="row">
                        <div class="col-12">
                            <div class="section-title"><i class="fas fa-shield-virus text-danger"></i> إعدادات الحماية</div>
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="alert alert-warning mb-3">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        هذه الإعدادات مهمة لأمان الموقع. تأكد من تطبيقها.
                                    </div>
                                    
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="secure_headers" checked>
                                                <label class="form-check-label fw-bold" for="secure_headers">إضافة رؤوس أمان (Security Headers)</label>
                                            </div>
                                            <small class="text-muted d-block mt-1">X-Content-Type-Options, X-Frame-Options, X-XSS-Protection</small>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="hsts" checked>
                                                <label class="form-check-label fw-bold" for="hsts">تفعيل HSTS</label>
                                            </div>
                                            <small class="text-muted d-block mt-1">يفرض على المتصفح استخدام HTTPS دائماً</small>
                                        </div>
                                    </div>

                                    <hr class="my-4">

                                    <h6 class="fw-bold mb-3">رؤوس الأمان الموصى بها لملف .htaccess:</h6>
                                    <div class="bg-dark text-light p-3 rounded-3 font-monospace small overflow-auto">
                                        <pre class="mb-0"># رؤوس الأمان
&lt;IfModule mod_headers.c&gt;
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Content-Security-Policy "default-src 'self'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
&lt;/IfModule&gt;</pre>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

