<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize Select2 for all select2 elements
        if (typeof $ !== 'undefined' && $.fn.select2) {
            $('.select2').select2({
                dir: 'rtl',
                width: '100%'
            });
        }

        // إعادة تهيئة Select2 عند عرض التبويب (لأنه لا يعمل على العناصر المخفية)
        const tabs = document.querySelectorAll('#settingsTabs .nav-link');
        tabs.forEach(tab => {
            tab.addEventListener('shown.bs.tab', function(e) {
                const target = e.target.getAttribute('data-bs-target');
                if (target === '#accounting' && typeof $ !== 'undefined' && $.fn.select2) {
                    $('#accounting .select2').each(function() {
                        $(this).select2({
                            dir: 'rtl',
                            width: '100%'
                        });
                    });
                }
            });
        });

        // Edit Relationship
        document.querySelectorAll('.edit-rel').forEach(btn => {
            btn.onclick = function() {
                const data = JSON.parse(this.dataset.json);
                document.getElementById('rel_id').value = data.id;
                document.getElementById('rel_name_ar').value = data.name_ar;
                document.getElementById('rel_name_en').value = data.name_en;
                new bootstrap.Modal(document.getElementById('relModal')).show();
            };
        });

        // Edit Requirement
        document.querySelectorAll('.edit-req').forEach(btn => {
            btn.onclick = function() {
                const data = JSON.parse(this.dataset.json);
                document.getElementById('req_id').value = data.id;
                document.getElementById('req_rel_id').value = data.relationship_id;
                document.getElementById('req_name').value = data.requirement_name;
                document.getElementById('req_min_age').value = data.min_age;
                document.getElementById('req_max_age').value = data.max_age;
                document.getElementById('req_gender').value = data.gender;
                document.getElementById('req_is_mandatory').checked = data.is_mandatory == 1;
                new bootstrap.Modal(document.getElementById('reqModal')).show();
            };
        });

        // سكربت إدارة العمرة (Hosts & Guarantors)
        const hostForm = document.getElementById('hostForm');
        if (hostForm) {
            hostForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                fetch('ajax_umrah.php', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === 'success') location.reload();
                        else Swal.fire('خطأ', data.message, 'error');
                    });
            });
        }

        document.querySelectorAll('.edit-host').forEach(btn => {
            btn.addEventListener('click', function() {
                const data = JSON.parse(this.dataset.json);
                document.getElementById('host_id_edit').value = data.id;
                document.getElementById('host_name_input').value = data.host_name;
                document.getElementById('host_phone_input').value = data.phone;
                document.getElementById('host_address_input').value = data.address;
                document.getElementById('host_national_input').value = data.national_address;
                new bootstrap.Modal(document.getElementById('addHostModal')).show();
            });
        });

        document.querySelectorAll('.delete-host').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: "سيتم حذف بيانات المستضيف!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، احذف',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch('ajax_umrah.php', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded'
                                },
                                body: `action=delete_host&id=${id}`
                            })
                            .then(res => res.json())
                            .then(data => {
                                if (data.status === 'success') location.reload();
                            });
                    }
                });
            });
        });

        const guarantorForm = document.getElementById('guarantorForm');
        if (guarantorForm) {
            guarantorForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                fetch('ajax_umrah.php', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === 'success') location.reload();
                        else Swal.fire('خطأ', data.message, 'error');
                    });
            });
        }

        document.querySelectorAll('.edit-guarantor').forEach(btn => {
            btn.addEventListener('click', function() {
                const data = JSON.parse(this.dataset.json);
                document.getElementById('guarantor_id_edit').value = data.id;
                document.getElementById('guarantor_name_input').value = data.guarantor_name;
                document.getElementById('guarantor_id_type_input').value = data.identity_type;
                document.getElementById('guarantor_id_num_input').value = data.identity_number;
                document.getElementById('guarantor_phone_input').value = data.phone;
                document.getElementById('guarantor_type_input').value = data.guarantor_type;
                document.getElementById('guarantor_address_input').value = data.address;
                new bootstrap.Modal(document.getElementById('addGuarantorModal')).show();
            });
        });

        document.querySelectorAll('.delete-guarantor').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                Swal.fire({
                    title: 'هل أنت متأكد؟',
                    text: "سيتم حذف بيانات الضامن!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، احذف',
                    cancelButtonText: 'إلغاء'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch('ajax_umrah.php', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded'
                                },
                                body: `action=delete_guarantor&id=${id}`
                            })
                            .then(res => res.json())
                            .then(data => {
                                if (data.status === 'success') location.reload();
                            });
                    }
                });
            });
        });

        // سكربت إدارة المهن (Work Visa)
        const profForm = document.getElementById('professionForm');
        const SETTINGS_CSRF_TOKEN = <?php echo json_encode($_SESSION['csrf_token'] ?? ''); ?>;
        if (profForm) {
            profForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                formData.append('csrf_token', SETTINGS_CSRF_TOKEN);
                const reqs = document.getElementById('prof_requirements').value.split('\n').filter(r => r.trim() !== '');
                formData.delete('requirements[]');
                reqs.forEach(r => formData.append('requirements[]', r));

                fetch('ajax_work_visa_settings.php?action=save_profession', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === 'success') location.reload();
                        else alert(data.message);
                    });
            });
        }

        document.querySelectorAll('.edit-profession').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                fetch('ajax_work_visa_settings.php?action=get_profession&id=' + id)
                    .then(res => res.json())
                    .then(data => {
                        document.getElementById('prof_id').value = data.id;
                        document.getElementById('prof_name_ar').value = data.name_ar;
                        document.getElementById('prof_code').value = data.code;
                        document.getElementById('prof_status').value = data.status;
                        document.getElementById('prof_requirements').value = data.requirements.join('\n');
                        if (data.rules) {
                            document.getElementById('prof_min_age').value = data.rules.min_age;
                            document.getElementById('prof_max_age').value = data.rules.max_age;
                            document.getElementById('prof_min_passport_validity').value = data.rules.min_passport_validity_months;
                            document.getElementById('prof_allowed_nationalities').value = data.rules.allowed_nationalities;
                        }
                        new bootstrap.Modal(document.getElementById('addProfessionModal')).show();
                    });
            });
        });

        document.querySelectorAll('.delete-profession').forEach(btn => {
            btn.addEventListener('click', function() {
                if (confirm('هل أنت متأكد من حذف هذه المهنة؟')) {
                    const id = this.dataset.id;
                    const formData = new FormData();
                    formData.append('id', id);
                    formData.append('csrf_token', SETTINGS_CSRF_TOKEN);
                    fetch('ajax_work_visa_settings.php?action=delete_profession', {
                            method: 'POST',
                            body: formData
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.status === 'success') location.reload();
                        });
                }
            });
        });

        const addSocialBtn = document.getElementById('add-social-link');
        if (addSocialBtn) {
            addSocialBtn.addEventListener('click', function() {
                const container = document.getElementById('social-links-container');
                const newItem = document.createElement('div');
                newItem.className = 'row g-2 mb-2 social-link-item';
                newItem.innerHTML = `
                <div class="col-md-4"><input type="text" name="social_platform_name[]" class="form-control" placeholder="المنصة"></div>
                <div class="col-md-7">
                    <input type="url" name="social_link_url[]" class="form-control" placeholder="الرابط">
                    <input type="hidden" name="social_link_id[]" value="0">
                </div>
                <div class="col-md-1"><button type="button" class="btn btn-outline-danger w-100 remove-social-link"><i class="fas fa-times"></i></button></div>
            `;
                container.appendChild(newItem);
            });
        }

        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-social-link') || e.target.closest('.remove-social-link')) {
                const item = e.target.closest('.social-link-item');
                item.remove();
            }
        });
    });

    // Attendance Location Functions (Global Scope)
    let locationModal;
    let locMap;
    let locMarker;
    let locCircle;

    document.addEventListener('DOMContentLoaded', function() {
        locationModal = new bootstrap.Modal(document.getElementById('locationModal'));

        // Initialize map when modal is shown
        const locationModalEl = document.getElementById('locationModal');
        locationModalEl.addEventListener('shown.bs.modal', function () {
            if (!locMap) {
                // Initialize map
                locMap = L.map('loc_map').setView([21.4858, 39.1925], 15); // Default to KSA

                // Street view layer
                const streetLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                });

                // Satellite view layer (Esri World Imagery)
                const satelliteLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    attribution: 'Tiles &copy; Esri &mdash; Source: Esri, DigitalGlobe, GeoEye, Earthstar Geographics, CNES/Airbus DS, USDA, USGS, AeroGRID, IGN, and the GIS User Community'
                });

                // Add street view as default
                streetLayer.addTo(locMap);

                // Add layer control (street/satellite toggle
                L.control.layers({
                    'خريطة الشوارع': streetLayer,
                    'اقمار اصطناعية': satelliteLayer
                }).addTo(locMap);

                // Add geocoder (search)
                L.Control.geocoder({
                    defaultMarkGeocode: false,
                    placeholder: 'ابحث عن موقع...',
                    errorMessage: 'لم يتم العثور على موقع'
                }).on('markgeocode', function(e) {
                    const bbox = e.geocode.bbox;
                    const poly = L.polygon([
                        bbox.getSouthEast(),
                        bbox.getNorthEast(),
                        bbox.getNorthWest(),
                        bbox.getSouthWest()
                    ]);
                    locMap.fitBounds(poly.getBounds());
                    // Set marker to result location
                    const lat = e.geocode.center.lat;
                    const lng = e.geocode.center.lng;
                    locMarker.setLatLng([lat, lng]);
                    document.getElementById('loc_lat').value = lat.toFixed(6);
                    document.getElementById('loc_lng').value = lng.toFixed(6);
                    updateMapCircle();
                }).addTo(locMap);

                // Add marker and circle
                locMarker = L.marker([21.4858, 39.1925], {draggable: true}).addTo(locMap);
                locCircle = L.circle([21.4858, 39.1925], {
                    color: '#0d6efd',
                    fillColor: '#0d6efd',
                    fillOpacity: 0.2,
                    radius: 100
                }).addTo(locMap);

                // Update inputs when marker is dragged
                locMarker.on('dragend', function(e) {
                    const pos = e.target.getLatLng();
                    document.getElementById('loc_lat').value = pos.lat.toFixed(6);
                    document.getElementById('loc_lng').value = pos.lng.toFixed(6);
                    updateMapCircle();
                });

                // Update inputs when map is clicked
                locMap.on('click', function(e) {
                    locMarker.setLatLng(e.latlng);
                    document.getElementById('loc_lat').value = e.latlng.lat.toFixed(6);
                    document.getElementById('loc_lng').value = e.latlng.lng.toFixed(6);
                    updateMapCircle();
                });

                // Update map when inputs change
                document.getElementById('loc_lat').addEventListener('input', updateMapFromInputs);
                document.getElementById('loc_lng').addEventListener('input', updateMapFromInputs);
                document.getElementById('loc_radius').addEventListener('input', updateMapCircle);
            }

            // Update map view based on current inputs
            updateMapFromInputs();
        });
    });

    function updateMapFromInputs() {
        const lat = parseFloat(document.getElementById('loc_lat').value) || 21.4858;
        const lng = parseFloat(document.getElementById('loc_lng').value) || 39.1925;

        if (locMap && locMarker && locCircle) {
            locMarker.setLatLng([lat, lng]);
            locMap.setView([lat, lng], 15);
            updateMapCircle();
        }
    }

    function updateMapCircle() {
        const lat = parseFloat(document.getElementById('loc_lat').value) || 21.4858;
        const lng = parseFloat(document.getElementById('loc_lng').value) || 39.1925;
        const radius = parseFloat(document.getElementById('loc_radius').value) || 100;

        if (locCircle) {
            locCircle.setLatLng([lat, lng]);
            locCircle.setRadius(radius);
        }
    }

    let locationPermModal;

    // Function to check geolocation permission and update button visibility
    async function checkGeolocationPermission() {
        const btn = document.getElementById('locationPermissionBtn');
        if (!btn) return;
        
        if (!navigator.geolocation || !navigator.permissions) {
            // If permissions API is not available, show the button by default
            btn.style.display = '';
            return;
        }
        
        try {
            const permission = await navigator.permissions.query({ name: 'geolocation' });
            
            // Update button visibility based on permission state
            if (permission.state === 'granted') {
                btn.style.display = 'none'; // Hide button if permission granted
            } else {
                btn.style.display = ''; // Show button if denied or prompt
            }
            
            // Listen for permission changes
            permission.onchange = function() {
                if (this.state === 'granted') {
                    btn.style.display = 'none';
                } else {
                    btn.style.display = '';
                }
            };
        } catch (error) {
            // If there's an error, show the button by default
            btn.style.display = '';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Initialize location permission modal
        locationPermModal = new bootstrap.Modal(document.getElementById('locationPermissionModal'));
        
        // Check geolocation permission and update button
        checkGeolocationPermission();
        
        // Check if we're in a secure context (for warning purposes only)
        const isSecure = window.isSecureContext;
        const isLocalhost = window.location.hostname === 'localhost' || 
                           window.location.hostname === '127.0.0.1' ||
                           window.location.hostname === '::1';
        
        // Function to show secure context warning (only if geolocation fails)
        function showSecureContextWarning() {
            const btn = document.getElementById('locationPermissionBtn');
            if (btn) {
                btn.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i> قد تحتاج HTTPS أو localhost';
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-warning');
                btn.onclick = function() {
                    alert('خدمة تحديد الموقع في معظم المتصفحات تعمل فقط عبر HTTPS أو على localhost.\n\nالرجاء:\n1. استخدام https:// بدلاً من http://\n2. أو استخدام localhost بدلاً من الـ IP\n3. أو في Chrome: اذهب إلى chrome://flags/#unsafely-treat-insecure-origin-as-secure وأضف http://192.168.0.93:8000');
                };
            }
        }
        
        // Check if we're on the attendance tab (either via URL parameter or hash)
        const urlParams = new URLSearchParams(window.location.search);
        const tabParam = urlParams.get('tab');
        const hash = window.location.hash;
        
        // If attendance tab is active, request location permission automatically
        if (tabParam === 'attendance' || hash === '#attendance') {
            setTimeout(function() {
                // Always try geolocation, even on HTTP
                if (navigator.geolocation) {
                    requestLocationPermission();
                } else {
                    // No geolocation support at all
                    showSecureContextWarning();
                }
            }, 500); // Small delay to let the page load
        }
        
        // Also listen for tab changes
        const tabs = document.querySelectorAll('[data-bs-toggle="tab"]');
        tabs.forEach(function(tab) {
            tab.addEventListener('shown.bs.tab', function(event) {
                const targetId = event.target.getAttribute('data-bs-target');
                if (targetId === '#attendance') {
                    // Always try geolocation on attendance tab
                    if (navigator.geolocation) {
                        requestLocationPermission();
                    }
                }
            });
        });
    });

    function requestLocationPermission() {
        // Check if we're in a secure context (for warning purposes only)
        const isSecure = window.isSecureContext;
        const isLocalhost = window.location.hostname === 'localhost' || 
                           window.location.hostname === '127.0.0.1' ||
                           window.location.hostname === '::1';
        
        // Function to show secure context warning
        function showSecureContextWarning() {
            const btn = document.getElementById('locationPermissionBtn');
            if (btn) {
                btn.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i> قد تحتاج HTTPS أو localhost';
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-warning');
                btn.onclick = function() {
                    alert('خدمة تحديد الموقع في معظم المتصفحات تعمل فقط عبر HTTPS أو على localhost.\n\nالرجاء:\n1. استخدام https:// بدلاً من http://\n2. أو استخدام localhost بدلاً من الـ IP\n3. أو في Chrome: اذهب إلى chrome://flags/#unsafely-treat-insecure-origin-as-secure وأضف http://192.168.0.93:8000');
                };
            }
        }
        
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    // Permission granted, show a success message and hide button
                    alert('تم السماح بالوصول للموقع بنجاح!');
                    const btn = document.getElementById('locationPermissionBtn');
                    if (btn) btn.style.display = 'none';
                },
                function(error) {
                    if (error.code === error.PERMISSION_DENIED) {
                        // Show detailed instructions modal
                        locationPermModal.show();
                    } else {
                        // For other errors, if not secure, show warning too
                        if (!isSecure && !isLocalhost) {
                            showSecureContextWarning();
                        } else {
                            let errorMsg;
                            switch(error.code) {
                                case error.POSITION_UNAVAILABLE:
                                    errorMsg = 'لم يتم تحديد الموقع.';
                                    break;
                                case error.TIMEOUT:
                                    errorMsg = 'الطلب استغرق وقتاً طويلاً.';
                                    break;
                                default:
                                    errorMsg = 'حدث خطأ غير معروف.';
                            }
                            alert(errorMsg);
                        }
                    }
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }
            );
        } else {
            showSecureContextWarning();
        }
    }
    
    function openAddLocationModal() {
        document.getElementById('loc_id').value = 0;
        document.getElementById('loc_modal_title').innerText = 'إضافة موقع جديد';
        document.getElementById('loc_name').value = '';
        document.getElementById('loc_lat').value = '';
        document.getElementById('loc_lng').value = '';
        document.getElementById('loc_radius').value = '100';
        document.getElementById('loc_active').value = '1';
        
        // Hide accuracy box
        document.getElementById('loc_accuracy_box').classList.add('d-none');
        
        // Clear employee selection
        const employeesSelect = document.getElementById('loc_employees');
        Array.from(employeesSelect.options).forEach(option => option.selected = false);
        
        locationModal.show();
    }

    function openEditLocationModal(id, name, lat, lng, radius, isActive, assignedEmployees = []) {
        document.getElementById('loc_id').value = id;
        document.getElementById('loc_modal_title').innerText = 'تعديل موقع';
        document.getElementById('loc_name').value = name;
        document.getElementById('loc_lat').value = lat;
        document.getElementById('loc_lng').value = lng;
        document.getElementById('loc_radius').value = radius;
        document.getElementById('loc_active').value = isActive;
        
        // Hide accuracy box
        document.getElementById('loc_accuracy_box').classList.add('d-none');
        
        // Set selected employees
        const employeesSelect = document.getElementById('loc_employees');
        Array.from(employeesSelect.options).forEach(option => {
            option.selected = assignedEmployees.includes(parseInt(option.value));
        });
        
        locationModal.show();
    }

    function getCurrentLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    document.getElementById('loc_lat').value = position.coords.latitude;
                    document.getElementById('loc_lng').value = position.coords.longitude;
                    
                    // Update the map
                    updateMapFromInputs();

                    // Show accuracy info
                    const accuracyBox = document.getElementById('loc_accuracy_box');
                    const accuracyText = document.getElementById('loc_accuracy_text');
                    const accuracy = position.coords.accuracy;
                    
                    if (accuracy) {
                        accuracyBox.classList.remove('d-none');
                        let accuracyClass = 'text-success';
                        let accuracyMsg = 'ممتاز!';
                        if (accuracy > 50) {
                            accuracyClass = 'text-warning';
                            accuracyMsg = 'جيد';
                        }
                        if (accuracy > 100) {
                            accuracyClass = 'text-danger';
                            accuracyMsg = 'ضعيف - يرجى المحاولة مرة أخرى في مكان مفتوح';
                        }
                        
                        accuracyText.innerHTML = `الدقة الحالية للموقع: <strong class="${accuracyClass}">${Math.round(accuracy)} متر</strong><br>${accuracyMsg}`;
                        
                        // Also suggest a radius that's at least the accuracy + 20m
                        const suggestedRadius = Math.max(100, Math.ceil(accuracy + 20));
                        document.getElementById('loc_radius').value = suggestedRadius;
                        updateMapCircle();
                    }
                },
                function(error) {
                    let errorMsg = '';
                    switch(error.code) {
                        case error.PERMISSION_DENIED:
                            errorMsg = "الرجاء السماح بالوصول إلى موقعك لتجربة هذه الخدمة";
                            break;
                        case error.POSITION_UNAVAILABLE:
                            errorMsg = "لم يتم تحديد الموقع، يرجى المحاولة مرة أخرى";
                            break;
                        case error.TIMEOUT:
                            errorMsg = "الطلب استغرق وقتاً طويلاً، يرجى المحاولة مرة أخرى";
                            break;
                        case error.UNKNOWN_ERROR:
                            errorMsg = "حدث خطأ غير معروف أثناء محاولة جلب الموقع";
                            break;
                    }
                    alert('خطأ في جلب الموقع: ' + errorMsg);
                },
                {
                    enableHighAccuracy: true,  // طلب دقة عالية
                    timeout: 10000,           // مهلة 10 ثوانٍ
                    maximumAge: 0             // عدم استخدم مواقع قديمة
                }
            );
        } else {
            alert('المتصفح الذي تستخدمه لا يدعم خدمة تحديد المواقع');
        }
    }

    // Request location permission on page load
    document.addEventListener('DOMContentLoaded', function() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function() { /* Success, permission granted */ },
                function() { /* Ignore error if user denies */ },
                { enableHighAccuracy: true }
            );
        }
    });

    $(document).ready(function() { 
        // إظهار رسالة عند حفظ الإعدادات 
        $('form').on('submit', function() { 
            // إضافة مؤشر تحميل 
            $('.btn-save').html('<i class="fas fa-spinner fa-spin me-2"></i> جاري الحفظ...').prop('disabled', true); 
        }); 
        
        // عند العودة من حفظ الإعدادات، إظهار رسالة نجاح 
        if (window.location.href.indexOf('&saved=1') > -1) { 
            // الرسالة تظهر بالفعل من خلال flash_message 
            // فقط قم بالتمرير إلى التبويب النشط 
            setTimeout(function() { 
                var activeTab = $('#activeTabInput').val(); 
                var targetElement = $('#' + activeTab); 
                if (targetElement.length) { 
                    $('html, body').animate({ 
                        scrollTop: targetElement.offset().top - 100 
                    }, 500); 
                } 
            }, 100); 
        } 
    });
</script>

