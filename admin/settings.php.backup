                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-bold">حفظ البيانات</button>
                </div>
            </form>
        </div>
